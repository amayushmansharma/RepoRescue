# Copy to .env and replace the placeholders. Never commit real credentials.

# PostgreSQL connection string used by Drizzle for scan + verification persistence.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: server-side GitHub token for live scans of public repositories.
# Raises the GitHub API rate limit. Never exposed to the browser.
# GITHUB_TOKEN=ghp_placeholder_replace_me

# Optional: set automatically by Next.js.
# NODE_ENV=development

# Optional: lock down iframe embedding for a production deployment.
# Leave unset for hosted previews that render the app inside an iframe.
# FRAME_ANCESTORS='none'
