# Copy to .env and adjust. Placeholders only — never commit real credentials.

# Express API port and bind address.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Vite dev server origin. Only needed when the client is served from a
# different origin than the API (the dev proxy makes requests same-origin).
CLIENT_ORIGIN=http://localhost:5173

# Optional: server-side GitHub token for live scans of public repositories.
# Raises the anonymous GitHub rate limit. Never sent to the browser.
GITHUB_TOKEN=

# Optional: Google Gemini API key for AI finding explanations.
# If omitted or invalid, RepoRescue transparently falls back to deterministic explanations.
GEMINI_API_KEY=

# Optional: GitHub OAuth application credentials for developer sign-in & PR delivery.
# Requests read:user and public_repo scopes (public_repo required only for user-directed fork PRs).
# Register an OAuth app at https://github.com/settings/developers
# Local callback: http://localhost:5173/api/auth/github/callback
# Railway callback: https://<your-app>.up.railway.app/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 64-hex-character secret for signing opaque session cookies (generate: openssl rand -hex 32)
# REQUIRED in production.
REPORESCUE_SESSION_SECRET=
# 64-hex-character key for AES-256-GCM encryption of persisted access tokens at rest (generate: openssl rand -hex 32)
# REQUIRED in production when persistent session storage is active.
REPORESCUE_TOKEN_ENCRYPTION_KEY=
# Optional: duration of non-persistent (transient) sessions in milliseconds (default: 14400000 = 4 hours)
# REPORESCUE_TRANSIENT_SESSION_TTL_MS=14400000
GITHUB_CALLBACK_URL=

# Scan & Session persistence: in-memory map mirrored to bounded JSON files.
# Set REPORESCUE_PERSIST=false to keep everything in memory only.
# On Railway, mount a Volume at /data and set REPORESCUE_DATA_DIR=/data
REPORESCUE_PERSIST=true
REPORESCUE_DATA_DIR=./server/data

# Optional: lock down iframe embedding (CSP frame-ancestors). Leave empty to allow.
FRAME_ANCESTORS=
# Set to true behind a reverse proxy (e.g., Railway, Cloudflare). Automatically inferred on Railway.
TRUST_PROXY=true
